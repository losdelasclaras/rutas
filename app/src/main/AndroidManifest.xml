<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true" android:supportsRtl="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements"/>

        <!-- la app: abre la web en Chrome a pantalla completa (Trusted Web Activity) -->
        <activity android:name=".WebActivity" android:exported="false" android:label="@string/app_name">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="https://losdelasclaras.github.io/rutas/"/>
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/rojo"/>
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/fondo"/>
            <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY" android:value="es.losdelasclaras.rutas.fileprovider"/>
        </activity>
        <!-- el icono (conserva su nombre de siempre, para que no desaparezca del escritorio al actualizar) abre directamente la web -->
        <activity-alias android:name="com.google.androidbrowserhelper.trusted.LauncherActivity" android:targetActivity=".WebActivity" android:exported="true" android:label="@string/app_name">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="https://losdelasclaras.github.io/rutas/"/>
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/rojo"/>
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/fondo"/>
            <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY" android:value="es.losdelasclaras.rutas.fileprovider"/>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- 8 nov 2026: los enlaces de la app (solo la página principal: el APK, gpx.html y privacidad.html siguen abriéndose en el navegador) (tracks compartidos, puntos…) se abren en la app; Android lo comprueba con
                 https://losdelasclaras.github.io/.well-known/assetlinks.json (repositorio losdelasclaras.github.io) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="losdelasclaras.github.io"/><data android:path="/rutas/"/><data android:path="/rutas"/><data android:path="/rutas/index.html"/>
            </intent-filter>
        </activity-alias>

        <!-- 9 nov 2026: «Salir» de la app sin cerrarla (la manda al escritorio); la web abre ldcrutas://salir -->
        <activity android:name=".SalirActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay" android:noHistory="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ldcrutas" android:host="salir"/>
            </intent-filter>
        </activity>

        <!-- «Abrir con» y «Compartir» para archivos GPX y KML -->
        <activity android:name=".AbrirActivity" android:exported="true" android:label="@string/app_name" android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/><data android:scheme="file"/>
                <data android:mimeType="application/gpx+xml"/><data android:mimeType="application/gpx"/><data android:mimeType="application/x-gpx+xml"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/><data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/xml"/><data android:mimeType="text/xml"/><data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/gpx+xml"/><data android:mimeType="application/gpx"/><data android:mimeType="application/x-gpx+xml"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/><data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/xml"/><data android:mimeType="text/xml"/>
            </intent-filter>
        </activity>

        <!-- grabar el recorrido con la pantalla apagada (la web lo abre con intent://grabar#Intent;scheme=ldcgrabar;…) -->
        <activity android:name=".GrabarActivity" android:exported="true" android:label="Grabar recorrido" android:launchMode="singleTask" android:taskAffinity="es.losdelasclaras.rutas.grabar"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ldcgrabar"/>
            </intent-filter>
        </activity>
        <!-- la ubicación para la web (dentro de la app Chrome no se la da): la pide a Android y vuelve a la web con ella -->
        <activity android:name=".UbicarActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ldcubicar"/>
            </intent-filter>
        </activity>
        <!-- enviar un GPX de verdad desde la web (Chrome no deja mandar archivos .gpx) -->
        <activity android:name=".CompartirActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ldcgpx"/>
            </intent-filter>
        </activity>
        <service android:name=".GrabarService" android:exported="false" android:foregroundServiceType="location"/>

        <provider android:name="androidx.core.content.FileProvider" android:authorities="es.losdelasclaras.rutas.fileprovider" android:grantUriPermissions="true" android:exported="false">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/filepaths"/>
        </provider>
    </application>
    <queries><intent><action android:name="android.support.customtabs.action.CustomTabsService"/></intent></queries>
</manifest>
